# LOCAL DEVELOPMENT ONLY. Copy to .env.local and generate a secret; never commit it.
AUCTA_LOCAL_MODE=true
APP_URL=http://localhost:3000
LOCAL_AUTH_SECRET=
PAYMENT_PROVIDER=mock
# Optional explicit local data location; default is .local/aucta-db.
AUCTA_LOCAL_DATA_DIR=
# Generate separately before enabling the authenticated closing endpoint.
CRON_SECRET=

# Dedicated AUCTA cloud configuration only. Never reuse Project Arena.
# Set AUCTA_LOCAL_MODE=false and disable mock payments on a hosted deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only scheduler credentials; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
